{
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/deal-flow",
      "destination": "/portfolio/",
      "permanent": true
    },
    {
      "source": "/registration",
      "destination": "/membership/#apply",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "buildCommand": "pip install --quiet Pillow >/dev/null 2>&1; python3 scripts/sync_notion.py; python3 build.py"
}
